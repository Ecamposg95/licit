# Copia a .env para desarrollo local. Nunca pongas secretos reales en el repositorio.

# Base de datos (Railway inyecta DATABASE_URL desde el servicio Postgres)
DATABASE_URL=postgresql://postgres:toor@localhost:5432/licit

# Sesiones
SESSION_SECRET=
SESSION_TTL_MINUTES=480

# Demo
DEMO_MODE=true
DEMO_BASE_DATE=2026-10-28
# Contraseña de los usuarios demo @dipromedic.example. Sin valor, no se crean.
DEMO_USER_PASSWORD=
FRESHNESS_TTL_HOURS=24
DISPLAY_TIMEZONE=America/Mexico_City

# Administrador TI real opcional (además de los usuarios demo)
ADMIN_EMAIL=
ADMIN_PASSWORD=

CORS_ORIGINS=http://localhost:5173

# Almacenamiento de archivos (documentos y PDFs del catálogo).
# Con las cuatro variables OBJECT_STORAGE_* se usa un bucket S3 compatible; con ninguna, el disco local (STORAGE_DIR).
# Una configuración a medias es un error: no se cae a disco en silencio.
# Endpoint del bucket S3 compatible (Railway Bucket, R2, MinIO...)
OBJECT_STORAGE_ENDPOINT=
# Nombre del bucket
OBJECT_STORAGE_BUCKET=
# Credenciales del bucket (no las subas al repositorio)
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Región del bucket; si queda vacía se usa «auto»
OBJECT_STORAGE_REGION=
# Carpeta del almacenamiento local cuando no hay bucket (se pierde al reiniciar en Railway)
STORAGE_DIR=./.storage
# Tamaño máximo de un documento cargado por la API, en bytes (15 MB)
DOCUMENT_MAX_BYTES=15728640

# Procesos del servicio
# 1 importa el catálogo real de Dipromedic/Traufix en el primer arranque (bootstrap); 0 lo omite
IMPORT_CATALOG=1
# 1 corre el worker de trabajos (búsqueda en vivo) en un hilo del servicio web; 0 lo apaga (pruebas)
JOBS_WORKER=1

# Próximas entregas (aún no se leen)
SEARCH_PROVIDER=dof_sidof
SEARCH_API_KEY=
LLM_PROVIDER=none
LLM_API_KEY=
